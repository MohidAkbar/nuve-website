.total{display:flex;justify-content:space-between;font-family:'Outfit',sans-serif;font-weight:600;font-size:18px;padding-top:14px;border-top:1px solid var(--line)}
#dr .btn{width:100%;margin-top:14px;text-align:center}

/* ============ CHECKOUT FORM ============ */
#checkoutForm{
  margin-top:16px;padding-top:16px;border-top:1px solid var(--line);
  display:none;flex-direction:column;gap:10px;

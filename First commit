.it .rm{background:none;border:0;color:var(--mut);cursor:pointer;font-size:13px;padding:2px 6px;text-decoration:underline;font-family:'Outfit',sans-serif}
.it .rm:hover{color:var(--ink)}
.x{background:none;border:0;color:var(--ink);font-size:22px;cursor:pointer;line-height:1}

}
#dr.o{transform:none}
#dr h3{display:flex;justify-content:space-between;font-size:22px;align-items:center;font-family:'Lora',serif}
#items{flex:1;overflow:auto;margin:16px 0}
.it{display:flex;justify-content:space-between;gap:10px;padding:12px 0;border-bottom:1px solid var(--line);font-size:15px;align-items:flex-start;font-family:'Outfit',sans-serif}

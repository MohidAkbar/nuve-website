  color:var(--ink);display:block;margin-bottom:2px;
}
#checkoutForm input,
#checkoutForm textarea{
  width:100%;padding:10px 12px;border-radius:10px;
  border:1.5px solid var(--line);background:var(--bg);color:var(--ink);
  font-family:'Outfit',sans-serif;font-size:15px;
  outline:none;transition:border-color .15s;
}
#checkoutForm input:focus,
#checkoutForm textarea:focus{border-color:var(--acc)}
#checkoutForm textarea{resize:vertical;min-height:60px}
#checkoutForm .row{display:flex;gap:8px}
#checkoutForm .row > div{flex:1}
.form-actions{display:flex;gap:8px;margin-top:6px}
.form-actions button{
  flex:1;padding:12px;border-radius:99px;border:0;cursor:pointer;
  font-family:'Outfit',sans-serif;font-weight:500;font-size:15px;
  transition:transform .15s,opacity .15s;
}
.form-actions .cancel{background:var(--soft);color:var(--ink)}
.form-actions .submit{background:var(--acc);color:var(--bg)}
.form-actions button:hover{opacity:.9}
#checkoutForm .note{
  font-size:12px;color:var(--mut);text-align:center;margin:4px 0 0;
  line-height:1.4;
}

.toast{position:fixed;bottom:calc(24px + env(safe-area-inset-bottom));left:50%;transform:translate(-50%,120%);background:var(--ink);color:var(--bg);padding:12px 24px;border-radius:99px;font-family:'Outfit',sans-serif;font-size:14px;z-index:50;transition:transform .3s;font-weight:500;max-width:90vw;text-align:center}
.toast.o{transform:translate(-50%,0)}

@media(max-width:800px){
  nav{display:none}
  .hamburger{display:block}

  .hero{grid-template-columns:1fr;gap:24px;padding:32px 5vw}
  .hero p{font-size:16px;max-width:100%}
  .hero h1{font-size:clamp(28px,7vw,40px);margin:10px 0 14px}
  .hero small{font-size:11px}
  .hero img{max-height:420px}

  section{padding:50px 5vw}
  .t{margin-bottom:28px}

  .about{grid-template-columns:1fr;gap:22px}
  .about p{font-size:15px}

  .body h3{font-size:19px}
  .price{font-size:21px}

  .contact-box{font-size:15px;line-height:1.9}
  .why-list{font-size:15px;text-align:left}

  footer{padding-top:40px}
  footer .l{gap:14px;font-size:14px}
  footer .flogo{height:54px}

  input,select,textarea,button{font-size:16px}
}

@media(max-width:400px){

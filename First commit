    sizes:{ '120ml':999, '150ml':1250, '250ml':1450 } },
  { id:'p3', name:'Balancing Tea Tree & Jojoba Oil', desc:'Tea tree and jojoba blend to balance scalp oils and soothe irritation.',
    img:'https://res.cloudinary.com/qf5ay1wl/image/upload/f_auto/q_auto/WhatsApp_Image_2026-11-06_at_12.21.17_AM.jpg',
    sizes:{ '120ml':999, '150ml':1250, '250ml':1450 } }
];

const cart = [];
const $ = s => document.querySelector(s);

function renderProducts(){
  const grid = $('#productGrid');
  grid.innerHTML = PRODUCTS.map(p => {
    const sizes = Object.keys(p.sizes);
    const defaultSize = sizes[1] || sizes[0];
    return `
    <div class="card">
      <img src="${p.img}" alt="${p.name}" loading="lazy">
      <div class="body">
        <h3>${p.name}</h3>
        <p>${p.desc}</p>
        <div class="sizes" data-product="${p.id}">
          ${sizes.map(s => `<button class="${s===defaultSize?'on':''}" data-size="${s}" data-price="${p.sizes[s]}">${s}</button>`).join('')}
        </div>
        <div class="price" data-price-for="${p.id}">Rs.${p.sizes[defaultSize].toLocaleString()}</div>
        <button class="btn" onclick="addToCart('${p.id}')">Add to Cart</button>
      </div>
    </div>`;
  }).join('');

  grid.querySelectorAll('.sizes').forEach(group => {
    group.addEventListener('click', e => {
      const btn = e.target.closest('button');
      if(!btn) return;
      group.querySelectorAll('button').forEach(b => b.classList.remove('on'));
      btn.classList.add('on');
      const pid = group.dataset.product;
      document.querySelector(`[data-price-for="${pid}"]`).textContent = `Rs.${(+btn.dataset.price).toLocaleString()}`;
    });
  });
}

function addToCart(pid){
  const p = PRODUCTS.find(x => x.id === pid);
  const group = document.querySelector(`.sizes[data-product="${pid}"]`);
  const active = group.querySelector('button.on');
  const size = active.dataset.size;
  const price = +active.dataset.price;
  const key = pid + '|' + size;
  const existing = cart.find(i => i.key === key);
  if(existing) existing.qty++;
  else cart.push({ key, name:p.name, size, price, qty:1 });
  updateCart();
  showToast(`${p.name} (${size}) added to cart`);
}

function removeItem(key){
  const idx = cart.findIndex(i => i.key === key);
  if(idx > -1) cart.splice(idx, 1);
  updateCart();
}

function updateCart(){
  const items = $('#items');
  if(cart.length === 0){
    items.innerHTML = '<p class="empty">Your cart is empty.</p>';
  } else {
    items.innerHTML = cart.map(i => `
      <div class="it">
        <div>${i.name}<small>${i.size} × ${i.qty}</small></div>
        <div style="text-align:right">
          <div>Rs.${(i.price*i.qty).toLocaleString()}</div>
          <button class="rm" onclick="removeItem('${i.key}')">Remove</button>
        </div>
      </div>`).join('');
  }
  const total = cart.reduce((s,i)=>s+i.price*i.qty,0);
  $('#total').textContent = 'Rs.' + total.toLocaleString();
  $('#cartCount').textContent = cart.reduce((s,i)=>s+i.qty,0);
}

function openCart(){
  $('#dr').classList.add('o');
  $('#overlay').classList.add('o');
  hideCheckout();
}
function closeCart(){
  $('#dr').classList.remove('o');
  $('#overlay').classList.remove('o');
  hideCheckout();
}

function showCheckout(){
  if(cart.length === 0){ showToast('Your cart is empty'); return; }
  $('#orderBtn').style.display = 'none';
  $('#checkoutForm').classList.add('on');
}
function hideCheckout(){
  $('#orderBtn').style.display = 'block';
  $('#checkoutForm').classList.remove('on');
}

function placeOrder(e){
  if(e) e.preventDefault();

  if(cart.length === 0){ showToast('Your cart is empty'); return; }

  const name = $('#cf-name').value.trim();
  const phone = $('#cf-phone').value.trim();
  const address = $('#cf-address').value.trim();
  const city = $('#cf-city').value.trim();
  const notes = $('#cf-notes').value.trim();

  if(!name || !phone || !address || !city){
    showToast('Please fill all required fields');
    return;
  }

  const total = cart.reduce((s,i)=>s+i.price*i.qty,0);
  const itemLines = cart.map((i, idx) =>
    `${idx+1}. ${i.name} (${i.size}) × ${i.qty} — Rs.${(i.price*i.qty).toLocaleString()}`
  ).join('\n');

  const message =
`*New Order — Nuve*

*Items:*
${itemLines}

*Total:* Rs.${total.toLocaleString()}

*Customer:*
Name: ${name}
Phone: ${phone}
Address: ${address}
City: ${city}${notes ? `\nNotes: ${notes}` : ''}

_Placed via nuve website_`;

  const waUrl = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(message)}`;

  window.location.href = waUrl;

  showToast('Opening WhatsApp… please send the message to confirm.');
  cart.length = 0;
  updateCart();
  setTimeout(()=>{ closeCart(); }, 900);
}

function openMobileMenu(){
  const m = $('#mobileMenu');
  m.style.display = 'flex';
  requestAnimationFrame(()=>m.classList.add('o'));
}
function closeMobileMenu(){
  const m = $('#mobileMenu');
  m.classList.remove('o');
  setTimeout(()=>{ m.style.display = 'none'; }, 300);
}

let toastTimer;
function showToast(msg){
  const t = $('#toast');
  t.textContent = msg;
  t.classList.add('o');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=>t.classList.remove('o'), 2800);
}

document.addEventListener('keydown', e => {
  if(e.key === 'Escape'){ closeCart(); closeMobileMenu(); }
});

renderProducts();
updateCart();
</script>
</body>
</html>

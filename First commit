<style>
:root{
  --bg:#fbf7ec;--card:#fff;--ink:#0d2a5c;--mut:#51607d;--acc:#0d2a5c;
  --soft:#efe8d6;--line:#e3dcc8;
}
html{scroll-behavior:smooth;scroll-padding-top:100px}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:'Outfit',system-ui,sans-serif;line-height:1.6}
h1,h2,h3{font-family:'Lora',Georgia,serif;margin:0;line-height:1.2;color:var(--ink)}
p{font-family:'Outfit',sans-serif;color:var(--mut)}
a{color:inherit;text-decoration:none}

/* ============ PROMO BAR ============ */
.bar{
  background:var(--ink);color:var(--bg);
  font-family:'Outfit',sans-serif;font-size:13px;font-weight:500;
  padding:8px 0;letter-spacing:.04em;
  overflow:hidden;white-space:nowrap;
}
.bar-track{
  display:inline-block;
  padding-left:100%;
  animation:marquee 22s linear infinite;
  will-change:transform;
}
.bar:hover .bar-track{animation-play-state:paused}
@keyframes marquee{
  from{transform:translateX(0)}
  to{transform:translateX(-100%)}
}

/* ============ HEADER ============ */
header{
  position:sticky;top:0;z-index:20;background:var(--ink);
  display:flex;align-items:center;justify-content:space-between;
  padding:10px calc(5vw + env(safe-area-inset-right)) 10px calc(5vw + env(safe-area-inset-left));
  padding-top:calc(10px + env(safe-area-inset-top));
  color:var(--bg);
}
header .brandlogo{height:52px;width:auto;display:block;object-fit:contain;background:var(--bg);border-radius:10px;padding:3px 10px}
nav{display:flex;gap:28px;font-family:'Outfit',sans-serif;font-weight:500;font-size:15px}
nav a{color:var(--bg)}
nav a:hover{opacity:.7}
.cartbtn{background:var(--bg);color:var(--ink);border:0;border-radius:99px;padding:9px 18px;font-family:'Outfit',sans-serif;font-weight:500;font-size:14px;cursor:pointer;transition:transform .15s;white-space:nowrap}
.cartbtn:hover{transform:translateY(-1px)}
.cartbtn .count{background:var(--ink);color:var(--bg);border-radius:99px;padding:0 7px;margin-left:6px;font-size:12px;font-weight:600}

.hamburger{
  display:none;background:none;border:0;color:var(--bg);cursor:pointer;
  padding:6px;font-size:26px;line-height:1;
}

.mobile-menu{
  display:none;position:fixed;top:0;left:0;right:0;bottom:0;
  background:var(--ink);z-index:40;padding:calc(20px + env(safe-area-inset-top)) 6vw 20px;
  flex-direction:column;gap:4px;transform:translateX(100%);transition:transform .3s;
}
.mobile-menu.o{transform:none}
.mobile-menu .close-mobile{
  align-self:flex-end;background:none;border:0;color:var(--bg);
  font-size:32px;line-height:1;cursor:pointer;margin-bottom:20px;
}
.mobile-menu a{
  color:var(--bg);font-family:'Outfit',sans-serif;font-size:22px;
  font-weight:500;padding:16px 0;border-bottom:1px solid rgba(251,247,236,.15);
}

/* ============ HERO ============ */
.hero{display:grid;grid-template-columns:1.05fr 1fr;align-items:center;gap:40px;padding:56px 5vw;max-width:1250px;margin:auto}
.hero small{font-family:'Outfit',sans-serif;letter-spacing:.2em;text-transform:uppercase;color:var(--mut);font-weight:500}
.hero h1{font-size:clamp(34px,5vw,60px);margin:14px 0 18px}
.hero p{font-size:18px;max-width:480px}
.hero-img-wrap{position:relative}
.hero img{width:100%;border-radius:28px;display:block;object-fit:contain;background:var(--soft);box-shadow:0 30px 60px -25px rgba(13,42,92,.45)}

.btn{display:inline-block;background:var(--acc);color:var(--bg);padding:14px 34px;border-radius:99px;font-family:'Outfit',sans-serif;font-weight:500;border:0;cursor:pointer;font-size:16px;margin-top:22px;transition:transform .15s,opacity .15s}
.btn:hover{transform:translateY(-2px);opacity:.92}
.btn:active{transform:translateY(0)}

.trust{display:flex;flex-wrap:wrap;justify-content:center;gap:14px 40px;background:var(--soft);padding:20px 5vw;font-family:'Outfit',sans-serif;font-weight:500;font-size:15px;color:var(--ink);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.trust span::before{content:"✦ ";color:var(--acc);opacity:.7}

section{padding:70px 5vw;max-width:1250px;margin:auto}
.t{text-align:center;margin-bottom:38px}
.t h2{font-size:clamp(28px,4vw,40px)}
.t p{margin:8px 0 0}

.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:26px}
.card{background:var(--card);border:1px solid var(--line);border-radius:22px;overflow:hidden;display:flex;flex-direction:column;transition:.3s}
.card:hover{transform:translateY(-6px);box-shadow:0 24px 44px -24px rgba(13,42,92,.4)}
.card img{width:100%;aspect-ratio:1/1.05;object-fit:contain;background:var(--soft);display:block}
.body{padding:20px;display:flex;flex-direction:column;gap:10px;flex:1}
.body h3{font-size:21px}
.body p{margin:0;font-size:15px}
.sizes{display:flex;gap:8px}
.sizes button{flex:1;padding:9px;border-radius:12px;border:1.5px solid var(--line);background:transparent;color:var(--ink);font-family:'Outfit',sans-serif;font-weight:500;font-size:14px;cursor:pointer;transition:.15s}
.sizes button.on{border-color:var(--acc);background:var(--acc);color:var(--bg)}
.price{font-family:'Outfit',sans-serif;font-size:24px;font-weight:600;color:var(--ink)}
.body .btn{margin:auto 0 0;width:100%;text-align:center;padding:12px}

.why{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:22px}
.why div{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:26px;text-align:center}
.why b{display:block;font-family:'Lora',serif;font-size:19px;margin:8px 0;color:var(--ink)}
.why span{font-size:34px}
.why p{margin:0;font-size:15px}

.why-list{
  list-style:none;padding:0;margin:8px auto 0;
  max-width:560px;text-align:left;
  font-family:'Outfit',sans-serif;font-size:16px;color:var(--mut);
  line-height:1.8;
}
.why-list li{position:relative;padding-left:22px}
.why-list li::before{content:"✓";position:absolute;left:0;top:0;color:var(--acc);font-weight:600}
.why-list b{color:var(--ink);font-weight:600;font-family:'Outfit',sans-serif}

.about{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}
.about img{width:100%;border-radius:26px;display:block;object-fit:contain;background:var(--soft)}
.about p{font-size:17px}
.about h2{font-size:clamp(26px,3.5vw,36px);margin-bottom:14px}

.contact-box{max-width:560px;margin:0 auto;text-align:center;font-family:'Outfit',sans-serif;color:var(--mut);font-size:17px;line-height:2}
.contact-box a{color:var(--ink);text-decoration:underline}
.contact-box a:hover{opacity:.7}

.contact-box .ig-link{display:inline-flex;align-items:center;gap:8px;color:var(--ink);text-decoration:none;font-weight:500;transition:opacity .15s}
.contact-box .ig-link:hover{opacity:.7}
.contact-box .ig-icon{width:22px;height:22px;flex-shrink:0;color:var(--ink);vertical-align:middle}

.contact-box .addr{display:inline-flex;align-items:flex-start;gap:8px;color:var(--ink);text-decoration:none;font-weight:500;line-height:1.5}
.contact-box .addr:hover{opacity:.7}
.contact-box .addr-icon{width:22px;height:22px;flex-shrink:0;color:var(--ink);margin-top:4px}

